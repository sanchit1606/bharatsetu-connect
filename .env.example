# Copy this file to .env and fill in the value.
# Do not commit .env to version control.

# Base URL of your deployed API (Lambda + API Gateway).
# No trailing slash. Example after deploying Amplify backend:
# VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/dev
VITE_API_URL=

# Optional: for "Listen to Analysis" TTS (ElevenLabs). Pass to backend when running sandbox:
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Get a key at https://elevenlabs.io/app/settings/api-keys

# CivicSense: Mail opens Gmail compose; WhatsApp opens wa.me. Override if needed.
# VITE_CIVICSENSE_PROTOTYPE_EMAIL=sanchitnipanikar@gmail.com
# VITE_CIVICSENSE_PROTOTYPE_WHATSAPP=918459597997
